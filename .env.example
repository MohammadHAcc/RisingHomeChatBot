# Facebook Messenger credentials
# Copy this file to .env and fill in your values

# The verify token you choose when setting up the webhook in Meta Developer App
MESSENGER_VERIFY_TOKEN=your_verify_token_here

# Page Access Token from Meta Developer App → Messenger → Settings
MESSENGER_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Port for the Express server (Messenger webhooks must be on HTTPS 443 in production)
PORT=3000

# Environment: development | production
NODE_ENV=development
